# ---------------------------------------------------------------------------
# Frontend environment variables (Vite)
#
# Only variables prefixed with VITE_ are exposed to the browser. Never put a
# secret in this file: anything here ends up in the client bundle.
# ---------------------------------------------------------------------------

# Base URL of the Laravel API.
#
#   Relative path (recommended) -> requests go through the Vite dev proxy
#   (see vite.config.ts), so they are same-origin and CORS never applies.
#
#   Absolute URL -> the browser calls the API directly. In that case the Laravel
#   backend must allow this origin, e.g. in student-api/.env:
#       CORS_ALLOWED_ORIGINS=http://localhost:5173
#
# Local development backend: http://127.0.0.1:8000/api/v1
VITE_API_BASE_URL=/api/v1

# Student profile id used by the student portal.
# The API has no "my profile" endpoint, so the seeded demo student's id is used.
# See student-web/docs/LIMITATIONS.md (workaround W2).
VITE_DEMO_STUDENT_ID=1
